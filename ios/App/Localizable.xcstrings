          }
        }
      }
    },
    "En borttagen medlem behåller sin historik — utgifter de var med på ändras inte." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A removed member keeps their history — expenses they were part of don't change."

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=kvitta;Username=kvitta",
    "MigrateOnStartup": true
  },
  "Sync": {
    "MaxPullLimit": 500,
    "MaxPushBatchSize": 500,
    "MaxPayloadBytes": 262144,
    "MinimumClientBuild": 3
  },
  "Auth": {
    "Issuer": "https://kvitta.local",
    "Audience": "se.kvitta.app",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 60,
    "AppleBundleId": "se.kvitta.app",
    "AllowDevTokens": true
  }
}
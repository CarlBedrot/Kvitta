    "Du" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You"
          }
        }
      }
    },
    "Du behöver inget konto för att använda Kvitta. Ett konto gör bara att dina utgifter finns kvar om telefonen försvinner." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't need an account to use Kvitta. An account just means your expenses are still there if the phone is lost."
          }
        }
      }
    },
    "Du betalade" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You paid"
          }
        }
      }
    },
    "Du har inga skulder och ingen ligger ute för dig." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have no debts and nobody is waiting on you."
          }
        }
      }
    },
    "Du kan lägga till någon som inte har appen. Utgifter fungerar likadant." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can add someone who doesn't have the app. Expenses work exactly the same."
          }
        }
      }
    },
    "Du ligger ute med" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're owed"
          }
        }
      }
    },
    "Du ska få" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're owed"
          }
        }
      }
    },
    "Du är ensam i gruppen till att börja med. Dela inbjudningslänken så går de andra med själva — då väljer de sina egna namn." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're on your own in the group to begin with. Share the invite link and the others join themselves — then they pick their own names."
          }
        }
      }
    },
    "Du är med i gruppen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're in the group."

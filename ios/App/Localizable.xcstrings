      }
    },
    "ECB:s referenskurser, hämtade %@. Används bara för ungefärlig omräkning — allt sparas exakt i sin egen valuta." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ECB reference rates, fetched %@. Used only for approximate conversion — everything is stored exactly in its own currency."
          }
        }
      }
    },
    "Efter betalningen: %@ · ni är kvitt i %@ 🎉" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the payment: %1$@ · you're settled in %2$@ 🎉"
